# API Harvard (obligatoire) — https://harvardartmuseums.org/collections/api
HARVARD_API_KEY=your_key_here

# Rythme d'enrichissement
MAX_NEW_PER_RUN=10
PAGE_SIZE=25
MAX_PAGES=20

# --- S3 : partagé enrichissement (local) + Space (inférence) ---
S3_BUCKET=artvision-base
AWS_REGION=eu-west-3

# --- Space HF uniquement (inférence) : à saisir dans Settings > Variables and secrets ---
# Accès LECTURE SEULE au bucket, via l'utilisateur IAM `artvision-space-reader`.
# Ces deux clés sont des SECRETS du Space (jamais committées, jamais dans l'image).
#   AWS_ACCESS_KEY_ID=...       (secret)
#   AWS_SECRET_ACCESS_KEY=...   (secret)
# Côté enrichissement (local), l'accès S3 passe par l'utilisateur IAM `artvision-local-enrich`
# (clés configurées via `aws configure`, jamais dans git).

# --- Guide LLM (guide_core.py) ---
LLM_PROVIDER=ollama
CHAT_MODEL=qwen2.5:7b-instruct-q5_K_M